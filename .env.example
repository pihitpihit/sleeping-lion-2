# 로컬 개발용 환경설정 보기.
# 이 파일을 `.env.local`로 복사해서 쓴다. `.env.local`은 커밋되지 않는다.

# 배포 모드 — demo | mock | live
#   demo  로그인 없음. 정식 서비스 후의 공개 페이지용.
#   mock  로그인 있음 + 가짜 백엔드. 서버 없이 흐름을 만져볼 때.
#   live  로그인 있음 + 진짜 백엔드.
#
# 없거나 모르는 값이면 live로 친다. 잠기는 쪽으로 틀리는 편이 낫다.
VITE_AUTH_MODE=mock

# 배포 경로. **로컬에서는 절대 켜지 마십시오.**
# 빌드와 미리보기의 값이 어긋나면 화면이 하얘지고 콘솔에는 아무것도 안 뜬다.
# VITE_BASE=/sleeping-lion-2/
